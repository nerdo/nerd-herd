{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!types/herdr",
      "!docs",
      "!.e2e-home",
      "!.e2e-bin",
      "!.hw-home",
      "!src/mod/vendor/**/*.js",
      "!scripts/serve-specs.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "on",
          "options": {
            "filenameCases": [
              "PascalCase",
              "camelCase",
              "kebab-case",
              "export"
            ],
            "strictCase": true,
            "requireAscii": true
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 300
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
