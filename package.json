{
  "name": "nerd-herd",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "specs:serve": "bun scripts/serve-specs.js docs/specs",
    "specs:check": "bun scripts/check-spec-refs.ts docs/specs/*/*.html",
    "herdr:types": "mkdir -p types/herdr && cp \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/herdr.d.ts\" \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/gpui-kit.d.ts\" types/herdr/",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.mod.json",
    "test": "bun test src scripts",
    "test:watch": "bun test --watch src",
    "test:coverage": "bun test --coverage src",
    "test:e2e": "bun run e2e:tools && playwright test",
    "check:boundaries": "fallow dead-code --boundary-violations",
    "check:expected-failures": "! grep -rnE \"(test|it)\\.(fail|failing)\\(\" src e2e",
    "start": "bun scripts/start.ts",
    "dev": "bun scripts/start.ts",
    "build": "bun scripts/build.ts",
    "check:mod": "bun run build && herdr-app check dist/mods/nerd-herd-spaces",
    "check:all": "bun run lint && bun run typecheck && bun run test && bun run check:boundaries && bun run check:expected-failures && bun run build",
    "e2e:tools": "mkdir -p .e2e-bin && swiftc -O e2e/support/read-text.swift -o .e2e-bin/read-text"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "fallow": "^3.43.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  }
}
